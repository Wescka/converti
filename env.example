# NUNCA subas la clave real al repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcionales
CONVERTI_MAX_MB=200
CONVERTI_TTL_SECONDS=1800
CONVERTI_CLEAN_INTERVAL=300
CONVERTI_COMMAND_TIMEOUT=900
CONVERTI_MAX_CONCURRENT=2
CONVERTI_RATE_PER_MIN=30
CONVERTI_MAX_PDF_PAGES=500
CONVERTI_MAX_IMAGE_PIXELS=100000000

# Producción: dejar en 0. Usar 1 solo para depuración local.
FLASK_DEBUG=0
